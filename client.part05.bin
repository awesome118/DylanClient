	<meta name="dylanclient-intro-attribution" content="Mojang Studios Logo Animation (Minecraft Dungeons), uploaded by Super Nixinova, https://www.youtube.com/watch?v=lo0nfVEo8LE; uploader-listed CC BY https://creativecommons.org/licenses/by/3.0/; remuxed first 3.25 seconds for DylanClient." />
	<title>DylanClient u1-beta</title>
	<link rel="icon" type="image/png" href="data:image/png;base64," />
	<style>
		#dylan_startup_intro {
			position: fixed;
			inset: 0;
			z-index: 2147483647;
			background: #ef323d;
			transition: opacity 750ms ease-in-out;
		}
		#dylan_startup_intro.is-ready { opacity: 0; pointer-events: none; }
		#dylan_intro_progress {
			position: absolute;
			bottom: 74px;
			left: 50%;
			transform: translateX(-50%);
			width: min(420px, 84vw);
			padding: 12px 16px;
			box-sizing: border-box;
			border-radius: 8px;
			background: rgba(0, 0, 0, 0.3);
			color: white;
			font: 13px system-ui, sans-serif;
			pointer-events: none;
		}
		#dylan_intro_progress_label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
		#dylan_intro_progress_status { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		#dylan_intro_progress_track { height: 5px; overflow: hidden; border-radius: 3px; background: rgba(255, 255, 255, 0.25); }
		#dylan_intro_progress_fill { height: 100%; background: white; transform: scaleX(0); transform-origin: left; transition: transform 250ms ease-out; }
		#dylan_startup_video { width: 100%; height: 100%; object-fit: cover; display: block; }
		#dylan_startup_video[hidden] { display: none; }
		#dylan_intro_sound {
			position: absolute;
			bottom: 28px;
			left: 0;
			right: 0;
			text-align: center;
			color: white;
			font: 14px system-ui, sans-serif;
			text-shadow: 0 1px 4px black;
		}
		#loading_screen {
			transition: opacity 180ms linear;
		}
		#loading_screen.is-ready {
			opacity: 0;
			pointer-events: none;
		}
		#boot_image {
			display: block;
			width: min(100vmin, 512px);
			height: min(100vmin, 512px);
			object-fit: contain;
			image-rendering: pixelated;
		}
		#boot_status {
			position: fixed;
			left: 16px;
			right: 16px;
			bottom: max(18px, 4vh);
			text-align: center;
			font: 14px/1.35 ui-monospace, "Cascadia Mono", "DejaVu Sans Mono", monospace;
			color: #4a4a4a;
		}
		#mojang_stage {
			display: none;
			width: min(75vw, 640px);
			aspect-ratio: 4 / 1;
		}
		#mojang_stage .half {
			display: block;
			width: calc(50% + 1px);
			height: 100%;
			background-image: url("data:image/png;base64,");
			background-repeat: no-repeat;
			background-size: 100% 200%;
			image-rendering: pixelated;
		}
		#mojang_stage .left { background-position: center top; }
		#mojang_stage .right {
			margin-left: -2px;
			background-position: center bottom;
		}
		#loading_screen.minecraft-stage { background: #ef323d !important; }
		#loading_screen.minecraft-stage #boot_image,
		#loading_screen.minecraft-stage #boot_status { display: none; }
		#loading_screen.minecraft-stage #mojang_stage { display: flex; }
		#rotate_device {
			display: none;
		}
		@media (orientation: portrait) and (pointer: coarse) {
			#rotate_device {
				position: fixed;
				z-index: 2147483647;
				inset: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 22px;
				padding: 32px;
				box-sizing: border-box;
				background: #111;
				color: #fff;
				text-align: center;
				font: 16px/1.45 ui-monospace, "Cascadia Mono", "DejaVu Sans Mono", monospace;
			}
			#rotate_device .phone {
				width: 42px;
				height: 70px;
				border: 4px solid #fff;
				border-radius: 7px;
				box-sizing: border-box;
				transform: rotate(90deg);
			}
			#rotate_device strong {
				display: block;
				margin-bottom: 5px;
				font-size: 19px;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			#loading_screen { transition: none; }
		}
