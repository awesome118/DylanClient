<body style="position:fixed;inset:0;margin:0;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;background-color:black;">
	<div id="dylan_startup_intro">
		<video id="dylan_startup_video" src="data:video/mp4;base64," preload="auto" playsinline disablepictureinpicture></video>
		<div id="dylan_intro_sound" hidden>Click anywhere for intro sound</div>
		<div id="dylan_intro_progress" role="progressbar" aria-label="Game loading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
			<div id="dylan_intro_progress_label"><span id="dylan_intro_progress_status">Starting DylanClient…</span><span id="dylan_intro_progress_percent">0%</span></div>
			<div id="dylan_intro_progress_track"><div id="dylan_intro_progress_fill"></div></div>
		</div>
	</div>
	<div id="loading_screen" style="margin:0px;position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483646;background-color:white;display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none;">
			<div style="text-align:center;">
				<img id="boot_image" src="data:image/png;base64," alt="EaglercraftX Wasm-GC" />
				<div id="mojang_stage" aria-hidden="true"><span class="half left"></span><span class="half right"></span></div>
				<div id="boot_status">Loading DylanClient 26.2 runtime…</div>
			</div>
		</div>
	<div id="game_frame" style="position:fixed;inset:0;margin:0;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;background-color:black;"></div>
	<div id="rotate_device" role="status" aria-live="polite">
		<div class="phone" aria-hidden="true"></div>
		<div><strong>Rotate your device</strong>DylanClient requires landscape mode on phones.</div>
	</div>
</body>
</html>
